<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A1A1A"
    android:gravity="center"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="♔ ChessBox ♚"
        android:textColor="#FFC107"
        android:textSize="44sp"
        android:textStyle="bold"
        android:layout_marginBottom="60dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTwoPlayers"
        style="@style/RoundedButtonLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="👥  Играть вдвоём"
        android:textColor="#FFFFFF"
        app:backgroundTint="#2E7D32"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVsComputer"
        style="@style/RoundedButtonLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🤖  Против компьютера"
        android:textColor="#FFFFFF"
        app:backgroundTint="#1565C0"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLan"
        style="@style/RoundedButtonLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🌐  Игра по LAN"
        android:textColor="#FFFFFF"
        app:backgroundTint="#6A1B9A"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSettings"
        style="@style/RoundedButtonLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚙️  Настройки"
        android:textColor="#FFFFFF"
        app:backgroundTint="#555555" />

</LinearLayout>
